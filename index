  const ctx2=document.getElementById('chartNetLine').getContext('2d');
  if(chartNetLine) chartNetLine.destroy();
  chartNetLine=new Chart(ctx2,{type:'line',data:{labels:MONTHS,datasets:[{label:'Net Credits (kWh)',data:netData,borderColor:'#F5A623',backgroundColor:'rgba(245,166,35,0.08)',pointBackgroundColor:netData.map(v=>v>=0?'#48BB78':'#F56565'),pointRadius:5,tension:0.3,fill:true}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:'rgba(0,0,0,0.05)'},title:{display:true,text:'kWh (+ credit / – deficit)'}}}}});
  const ym=currentYM();
  const ymSel=yr===currentYear()?ym:yr+'-01';
  const entries=getMonthEntries(ymSel).slice(-31);
  const dLabels=entries.map(([d])=>String(parseDate(d).getDate()));
  const dNet=entries.map(([,v])=>parseFloat((v.solar-v.usage).toFixed(2)));
  const ctx3=document.getElementById('chartDailyBar').getContext('2d');
  if(chartDailyBar) chartDailyBar.destroy();
  chartDailyBar=new Chart(ctx3,{type:'bar',data:{labels:dLabels,datasets:[{label:'Daily Net (kWh)',data:dNet,backgroundColor:dNet.map(v=>v>=0?'rgba(72,187,120,0.7)':'rgba(245,101,101,0.65)'),borderRadius:3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:'rgba(0,0,0,0.05)'}}}}});
  const years=[...new Set([currentYear(),...allYears()])].sort();
  const ctx4=document.getElementById('chartAnnualBar').getContext('2d');
  if(chartAnnualBar) chartAnnualBar.destroy();
  chartAnnualBar=new Chart(ctx4,{type:'bar',data:{labels:years,datasets:[{label:'Solar Generated',data:years.map(y=>parseFloat(yearSum(y).solar.toFixed(2))),backgroundColor:'rgba(245,166,35,0.75)',borderRadius:4},{label:'Household Used',data:years.map(y=>parseFloat(yearSum(y).usage.toFixed(2))),backgroundColor:'rgba(61,107,158,0.65)',borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'top'}},scales:{y:{grid:{color:'rgba(0,0,0,0.05)'}}}}});
}

// ── PREDICTION ──
let chartPredict=null, chartWinterHigh=null, chartWinterLow=null;
const HIGH_SCENARIO = 1100; // kWh per month Oct/Nov/Dec
const LOW_SCENARIO = 700;

function initPredict() {
  const sWrap=document.getElementById('predictSolarInputs');
  const uWrap=document.getElementById('predictUsageInputs');
  if(sWrap.children.length>0) return;
  MONTHS.forEach((m,i)=>{
    sWrap.innerHTML+=`<div class="predict-cell"><label>${m}</label><input type="number" id="ps_${i}" placeholder="kWh" step="0.1" min="0" inputmode="decimal"></div>`;
    uWrap.innerHTML+=`<div class="predict-cell"><label>${m}</label><input type="number" id="pu_${i}" placeholder="kWh" step="0.1" min="0" inputmode="decimal"></div>`;
  });
}
function fillPredictFromActuals() {
  const yr=currentYear();
  MONTHS.forEach((_,i)=>{
    const ym=yr+'-'+String(i+1).padStart(2,'0');
    const s=monthSum(ym);
    if(s.solar>0) document.getElementById('ps_'+i).value=s.solar.toFixed(1);
    if(s.usage>0) document.getElementById('pu_'+i).value=s.usage.toFixed(1);
  });
}
function clearPrediction() {
  MONTHS.forEach((_,i)=>{document.getElementById('ps_'+i).value='';document.getElementById('pu_'+i).value='';});
  document.getElementById('predictResults').style.display='none';
  document.getElementById('winterChartsSection').style.display='none';
  document.getElementById('winterGoalContent').innerHTML='<div class="empty"><div class="empty-text">Run the annual forecast below to see winter goal projections.</div></div>';
}

function runPrediction() {
  const solar=MONTHS.map((_,i)=>parseFloat(document.getElementById('ps_'+i).value)||0);
  const usage=MONTHS.map((_,i)=>parseFloat(document.getElementById('pu_'+i).value)||0);
  const net=solar.map((s,i)=>s-usage[i]);
  const annualNet=net.reduce((a,b)=>a+b,0);
  const creditMonths=net.filter(v=>v>0).length;
  const deficitMonths=net.filter(v=>v<0).length;

  // Summary
  document.getElementById('predictAnnualVal').textContent=fmt(annualNet)+' kWh';
  document.getElementById('predictSummary').className='predict-result '+(annualNet>=0?'pos':'neg');
  document.getElementById('predictCreditMonths').textContent=creditMonths+' months';
  document.getElementById('predictDeficitMonths').textContent=deficitMonths+' months';

  // Table
  let rows=MONTHS.map((m,i)=>`<tr><td>${m}</td><td style="color:var(--sun)">${solar[i].toFixed(1)}</td><td style="color:var(--sky-light)">${usage[i].toFixed(1)}</td><td><span class="badge ${net[i]>=0?'badge-credit':'badge-deficit'}">${fmt(net[i])} kWh</span></td></tr>`).join('');
  document.getElementById('predictTable').innerHTML=`<thead><tr><th>Month</th><th>Solar (kWh)</th><th>Used (kWh)</th><th>Net Balance</th></tr></thead><tbody>${rows}</tbody>`;

  // Annual chart
  const ctx=document.getElementById('chartPredict').getContext('2d');
  if(chartPredict) chartPredict.destroy();
  chartPredict=new Chart(ctx,{type:'bar',data:{labels:MONTHS,datasets:[{label:'Solar Generated',data:solar,backgroundColor:'rgba(245,166,35,0.75)',borderRadius:3},{label:'Household Used',data:usage,backgroundColor:'rgba(61,107,158,0.65)',borderRadius:3},{label:'Net Balance',data:net,type:'line',borderColor:net.map(v=>v>=0?'#48BB78':'#F56565'),backgroundColor:'transparent',pointBackgroundColor:net.map(v=>v>=0?'#48BB78':'#F56565'),pointRadius:5,tension:0.3}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'top'}},scales:{y:{grid:{color:'rgba(0,0,0,0.05)'}}}}});

  document.getElementById('predictResults').style.display='block';

  // ── WINTER GOAL CALCULATIONS ──
  // Jan–Sep banked credits (months 0-8), then Oct–Dec draws (months 9-11)
  // For each scenario: override Oct/Nov/Dec usage with scenario value, keep solar from inputs
  renderWinterGoal(solar, usage, net, annualNet);

  document.getElementById('predictResults').scrollIntoView({behavior:'smooth',block:'nearest'});
}

function renderWinterGoal(solar, usage, net, annualNet) {
  // Banked credits from Jan–Sep (months 0–8) using forecast
  const janSepNet = net.slice(0,9).reduce((a,b)=>a+b,0);

  // For each scenario, override Oct/Nov/Dec usage
  function scenarioCalc(winterUsagePerMonth) {
    const s = [...solar]; // same solar
    const u = [...usage];
    // Override Oct(9), Nov(10), Dec(11)
    u[9] = winterUsagePerMonth;
    u[10] = winterUsagePerMonth;
    u[11] = winterUsagePerMonth;
    const n = s.map((sv,i) => sv - u[i]);
    const winterSolar = s.slice(9).reduce((a,b)=>a+b,0);
    const winterUsage = u.slice(9).reduce((a,b)=>a+b,0);
    const winterNet = n.slice(9).reduce((a,b)=>a+b,0);
    const totalAnnualNet = n.reduce((a,b)=>a+b,0);
    // Running cumulative balance month by month
    let cumulative = [];
    let running = 0;
    n.forEach(v => { running += v; cumulative.push(parseFloat(running.toFixed(2))); });
    return { n, u, s, winterSolar, winterUsage, winterNet, totalAnnualNet, cumulative };
  }

  const high = scenarioCalc(HIGH_SCENARIO);
  const low  = scenarioCalc(LOW_SCENARIO);

  // Winter goal = total Oct+Nov+Dec usage
  const highWinterNeed = HIGH_SCENARIO * 3;
  const lowWinterNeed  = LOW_SCENARIO * 3;

  // How much is covered by banked Jan-Sep credits + Oct-Dec solar?
  const highWinterSolar = high.s.slice(9).reduce((a,b)=>a+b,0);
  const lowWinterSolar  = low.s.slice(9).reduce((a,b)=>a+b,0);
  const highCoverage = janSepNet + highWinterSolar; // total energy available for winter
  const lowCoverage  = janSepNet + lowWinterSolar;
  const highShortfall = highWinterNeed - highCoverage;
  const lowShortfall  = lowWinterNeed  - lowCoverage;
  const highPct = Math.min(100, Math.max(0, (highCoverage / highWinterNeed) * 100));
  const lowPct  = Math.min(100, Math.max(0, (lowCoverage  / lowWinterNeed)  * 100));

  // Render tracker
  const winHtml = `
    <div class="scenario-cards">
      <div class="scenario-card high">
        <div class="scenario-label">Scenario A — 1,100 kWh/mo</div>
        <div class="scenario-value">${highShortfall > 0 ? '-'+Math.abs(highShortfall).toFixed(0) : '+'+Math.abs(highShortfall).toFixed(0)} kWh</div>
        <div class="scenario-detail">${highShortfall > 0 ? `Projected shortfall of ${Math.abs(highShortfall).toFixed(0)} kWh. You\'ll need grid power for the balance.` : `Projected surplus of ${Math.abs(highShortfall).toFixed(0)} kWh — full winter covered!`}</div>
      </div>
      <div class="scenario-card low">
        <div class="scenario-label">Scenario B — 700 kWh/mo</div>
        <div class="scenario-value">${lowShortfall > 0 ? '-'+Math.abs(lowShortfall).toFixed(0) : '+'+Math.abs(lowShortfall).toFixed(0)} kWh</div>
        <div class="scenario-detail">${lowShortfall > 0 ? `Projected shortfall of ${Math.abs(lowShortfall).toFixed(0)} kWh. Some grid power needed.` : `Projected surplus of ${Math.abs(lowShortfall).toFixed(0)} kWh — full winter covered!`}</div>
      </div>
    </div>
    <div style="margin-bottom:14px">
      <div class="goal-progress-wrap">
        <div class="goal-progress-label"><span>Scenario A — Coverage of 3,300 kWh winter need</span><span>${highPct.toFixed(0)}%</span></div>
        <div class="goal-progress-track">
          <div class="goal-progress-fill ${highPct>=100?'good':highPct>=70?'warn':'bad'}" style="width:${highPct}%"></div>
        </div>
      </div>
      <div class="goal-progress-wrap" style="margin-top:10px">
        <div class="goal-progress-label"><span>Scenario B — Coverage of 2,100 kWh winter need</span><span>${lowPct.toFixed(0)}%</span></div>
        <div class="goal-progress-track">
          <div class="goal-progress-fill ${lowPct>=100?'good':lowPct>=70?'warn':'bad'}" style="width:${lowPct}%"></div>
        </div>
      </div>
    </div>
    <div style="font-size:11px;color:var(--text-muted);line-height:1.6">
      <strong>Banked Jan–Sep credits (forecast):</strong> ${fmt(janSepNet)} kWh &nbsp;·&nbsp;
      <strong>Oct–Dec solar (forecast):</strong> +${highWinterSolar.toFixed(0)} kWh &nbsp;·&nbsp;
      <strong>Total available for winter:</strong> ${highCoverage.toFixed(0)} kWh
    </div>`;
  document.getElementById('winterGoalContent').innerHTML = winHtml;

  // ── WINTER SCENARIO CHARTS ──
  // Cumulative running balance — full year
  const cumulLabels = MONTHS;

  // Chart: High scenario (1100 kWh)
  const ctxH = document.getElementById('chartWinterHigh').getContext('2d');
  if(chartWinterHigh) chartWinterHigh.destroy();
  chartWinterHigh = new Chart(ctxH, {
    type: 'bar',
    data: {
      labels: cumulLabels,
      datasets: [
        { label: 'Solar Generated', data: high.s, backgroundColor: MONTHS.map((_,i)=>i>=9?'rgba(245,101,101,0.35)':'rgba(245,166,35,0.7)'), borderRadius: 3, order: 2 },
        { label: 'Household Used', data: high.u, backgroundColor: MONTHS.map((_,i)=>i>=9?'rgba(245,101,101,0.65)':'rgba(61,107,158,0.5)'), borderRadius: 3, order: 2 },
        { label: 'Cumulative Net Balance', data: high.cumulative, type: 'line',
          borderColor: '#F5A623', backgroundColor: 'rgba(245,166,35,0.06)',
          pointBackgroundColor: high.cumulative.map(v=>v>=0?'#48BB78':'#F56565'),
          pointRadius: 5, tension: 0.3, fill: true, order: 1, yAxisID: 'y' }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 10 } } },
        annotation: {},
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + ' kWh' } }
      },
      scales: {
        y: { grid: { color: 'rgba(0,0,0,0.05)' }, title: { display: true, text: 'kWh' } }
      }
    }
  });

  // Chart: Low scenario (700 kWh)
  const ctxL = document.getElementById('chartWinterLow').getContext('2d');
  if(chartWinterLow) chartWinterLow.destroy();
  chartWinterLow = new Chart(ctxL, {
    type: 'bar',
    data: {
      labels: cumulLabels,
      datasets: [
        { label: 'Solar Generated', data: low.s, backgroundColor: MONTHS.map((_,i)=>i>=9?'rgba(72,187,120,0.35)':'rgba(245,166,35,0.7)'), borderRadius: 3, order: 2 },
        { label: 'Household Used', data: low.u, backgroundColor: MONTHS.map((_,i)=>i>=9?'rgba(72,187,120,0.65)':'rgba(61,107,158,0.5)'), borderRadius: 3, order: 2 },
        { label: 'Cumulative Net Balance', data: low.cumulative, type: 'line',
          borderColor: '#48BB78', backgroundColor: 'rgba(72,187,120,0.06)',
          pointBackgroundColor: low.cumulative.map(v=>v>=0?'#48BB78':'#F56565'),
          pointRadius: 5, tension: 0.3, fill: true, order: 1, yAxisID: 'y' }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'top', labels: { font: { size: 10 } } },
        tooltip: { callbacks: { label: ctx => ctx.dataset.label + ': ' + ctx.parsed.y.toFixed(1) + ' kWh' } }
      },
      scales: {
        y: { grid: { color: 'rgba(0,0,0,0.05)' }, title: { display: true, text: 'kWh' } }
      }
    }
  });

  document.getElementById('winterChartsSection').style.display = 'block';
}

// ── ARCHIVE ──
function renderArchive() {
  const wrap=document.getElementById('archiveContent');
  const years=allYears().sort().reverse();
  if(!years.length){wrap.innerHTML='<div class="empty"><div class="empty-icon">📚</div><div class="empty-text">No historical data yet.</div></div>';return;}
  wrap.innerHTML=years.map(yr=>{
    const yTot=yearSum(yr);
    const monthRows=MONTHS.map((m,i)=>{
      const ym=yr+'-'+String(i+1).padStart(2,'0');
      const s=monthSum(ym);
      const ec=getMonthEntries(ym).length;
      if(ec===0&&s.solar===0) return '';
      return `<tr><td style="font-weight:500">${m} ${yr}</td><td style="color:var(--sun)">${s.solar.toFixed(2)}</td><td style="color:var(--sky-light)">${s.usage.toFixed(2)}</td><td><span class="badge ${s.net>=0?'badge-credit':'badge-deficit'}">${fmt(s.net)} kWh</span></td><td style="color:var(--text-muted);font-size:11px">${ec}d</td></tr>`;
    }).filter(Boolean).join('');
    return `<div class="archive-year">
      <div class="archive-year-header">${yr}</div>
      <div class="archive-meta" style="margin-bottom:10px">Annual net: <strong style="color:${yTot.net>=0?'var(--credit)':'var(--deficit)'}">${fmt(yTot.net)} kWh</strong> &nbsp;·&nbsp; ☀️ ${yTot.solar.toFixed(1)} generated &nbsp;·&nbsp; ⚡ ${yTot.usage.toFixed(1)} used</div>
      <div class="card" style="padding:0;overflow:hidden">
        <div class="table-scroll"><table class="data-table"><thead><tr><th>Month</th><th>Solar</th><th>Used</th><th>Net</th><th>Days</th></tr></thead><tbody>${monthRows}</tbody></table></div>
      </div>
    </div>`;
  }).join('');
}

