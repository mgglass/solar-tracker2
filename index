  }
  const months12=[]; const now=new Date();
  for(let i=11;i>=0;i--){const d=new Date(now.getFullYear(),now.getMonth()-i,1);months12.push(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'));}
  const labels=months12.map(ym=>{const[y,m]=ym.split('-');return MONTHS[parseInt(m)-1]+"'"+y.slice(2);});
  const netData=months12.map(ym=>parseFloat(monthSum(ym).net.toFixed(2)));
  const ctx=document.getElementById('chartDashMonthly').getContext('2d');
  if(chartDashMonthly) chartDashMonthly.destroy();
  chartDashMonthly=new Chart(ctx,{type:'bar',data:{labels,datasets:[{label:'Net Balance (kWh)',data:netData,backgroundColor:netData.map(v=>v>=0?'rgba(72,187,120,0.7)':'rgba(245,101,101,0.7)'),borderRadius:4}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{grid:{color:'rgba(0,0,0,0.05)'}}}}});

  // Dollar tiles on dashboard
  renderDollarTiles('dash');
  updateRateDisplays();
}

