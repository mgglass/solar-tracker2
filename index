function renderAll() {
  renderHeader();
  populateMonthFilter();
  renderLogTable();
  renderDollarTiles('tile');
  updateRateDisplays();
}

// ── INIT ──
document.getElementById('entryDate').value = today();
populateBulkSelectors();
updateRateDisplays();
renderAll();
</script>
