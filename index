<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#1A2E44">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/svg+xml;base64,"/>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;base64,"/>
<meta name="apple-mobile-web-app-title" content="Solar"/>
<title>Solar Net Metering</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Mono:wght@300;400;500&family=Fraunces:ital,wght@0,300;0,600;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --sun: #F5A623;
    --sun-light: #FDE8BB;
    --sun-pale: #FEF6E4;
    --sky: #1A2E44;
    --sky-mid: #2C4A6E;
    --sky-light: #3D6B9E;
    --credit: #48BB78;
    --deficit: #F56565;
    --card: #FFFFFF;
    --border: #E8EDF2;
    --text: #1A2E44;
    --text-muted: #6B7C93;
    --bg: #F4F7FA;
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-bot: env(safe-area-inset-bottom, 0px);
    --safe-l: env(safe-area-inset-left, 0px);
    --safe-r: env(safe-area-inset-right, 0px);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'DM Mono', monospace;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }

  /* ── HEADER ── */
  .header {
    background: var(--sky);
    color: white;
    padding-top: var(--safe-top);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .header-inner {
    padding: 16px 16px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 50%, rgba(245,166,35,0.18) 0%, transparent 60%);
    pointer-events: none;
  }
  .sun-icon {
    width: 36px; height: 36px;
    background: var(--sun);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 6px rgba(245,166,35,0.2);
    animation: pulse 4s ease-in-out infinite;
  }
  @keyframes pulse {
    0%,100% { box-shadow: 0 0 0 6px rgba(245,166,35,0.2); }
    50% { box-shadow: 0 0 0 10px rgba(245,166,35,0.15); }
  }
  .header-title-group { display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0; }
  .header h1 {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .header h1 span { color: var(--sun); }
  .header-sub { font-size: 10px; opacity: 0.55; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 2px; }
  .header-stats { display: flex; gap: 16px; flex-shrink: 0; }
  .hstat { text-align: right; }
  .hstat-label { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5; }
  .hstat-value { font-family: 'Fraunces', serif; font-size: 16px; font-weight: 600; }
  .hstat-value.positive { color: var(--credit); }
  .hstat-value.negative { color: var(--deficit); }
  .hstat-value.neutral { color: var(--sun); }

  /* ── BOTTOM NAV (mobile) ── */
  .bottom-nav {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--sky);
    display: flex;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-bottom: var(--safe-bot);
    z-index: 100;
  }
  .bnav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px 4px 8px;
    cursor: pointer;
    border: none;
    background: none;
    color: rgba(255,255,255,0.4);
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.04em;
    gap: 3px;
    transition: color 0.15s;
    -webkit-tap-highlight-color: transparent;
    min-height: 56px;
  }
  .bnav-item.active { color: var(--sun); }
  .bnav-item svg { width: 20px; height: 20px; stroke-width: 1.8; fill: none; stroke: currentColor; }

  /* ── TOP TABS (desktop) ── */
  .top-tabs {
    background: var(--sky-mid);
    display: none;
  }
  .top-tabs-inner { display: flex; gap: 2px; padding: 0 24px; max-width: 1280px; margin: 0 auto; }
  .tab {
    padding: 11px 18px;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
    cursor: pointer;
    border: none;
    background: none;
    font-family: 'DM Mono', monospace;
    position: relative;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .tab:hover { color: rgba(255,255,255,0.8); }
  .tab.active { color: var(--sun); }
  .tab.active::after { content:''; position:absolute; bottom:0;left:0;right:0; height:2px; background:var(--sun); }

  /* ── MAIN ── */
  .main {
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 16px calc(72px + var(--safe-bot));
  }
  .panel { display: none; }
  .panel.active { display: block; }

  /* ── CARDS ── */
  .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 18px; }
  .card + .card { margin-top: 14px; }
  .card-title {
    font-family: 'Fraunces', serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--sky);
    margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .card-title .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sun); flex-shrink: 0; }

  /* ── GRIDS ── */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .grid-4 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .section-gap { margin-top: 16px; }

  /* ── STAT TILES ── */
  .stat-tile { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 16px; position: relative; overflow: hidden; }
  .stat-tile::before { content:''; position:absolute; top:0;left:0;right:0; height:3px; }
  .stat-tile.credit::before { background: var(--credit); }
  .stat-tile.deficit::before { background: var(--deficit); }
  .stat-tile.solar::before { background: var(--sun); }
  .stat-tile.usage::before { background: var(--sky-light); }
  .stat-label { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; }
  .stat-number { font-family: 'Fraunces', serif; font-size: 26px; font-weight: 600; line-height: 1; }
  .stat-number.pos { color: var(--credit); }
  .stat-number.neg { color: var(--deficit); }
  .stat-number.sun { color: var(--sun); }
  .stat-number.sky { color: var(--sky-light); }
  .stat-unit { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

  /* ── FORMS ── */
  .form-stack { display: flex; flex-direction: column; gap: 12px; }
  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-label { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  input[type="date"], input[type="number"], input[type="text"], select {
    padding: 13px 14px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: 'DM Mono', monospace;
    font-size: 16px; /* prevents iOS zoom */
    color: var(--text);
    background: white;
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  input:focus, select:focus { outline: none; border-color: var(--sun); box-shadow: 0 0 0 3px rgba(245,166,35,0.15); }
  .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  .btn {
    padding: 14px 20px;
    border: none; border-radius: 10px;
    cursor: pointer;
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 500;
    transition: all 0.2s;
    min-height: 48px;
    display: inline-flex; align-items: center; justify-content: center;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .btn-primary { background: var(--sky); color: white; }
  .btn-primary:active { background: var(--sky-mid); }
  .btn-sun { background: var(--sun); color: var(--sky); font-weight: 600; }
  .btn-sun:active { background: #e8961a; }
  .btn-ghost { background: transparent; color: var(--text-muted); border: 1.5px solid var(--border); }
  .btn-ghost:active { background: var(--bg); }
  .btn-danger { background: transparent; color: var(--deficit); border: 1.5px solid rgba(245,101,101,0.3); padding: 8px 14px; font-size: 11px; min-height: 36px; border-radius: 8px; }
  .btn-full { width: 100%; }
  .btn-row { display: flex; gap: 10px; flex-wrap: wrap; }

  /* ── TABLE ── */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 10px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 380px; }
  .data-table th { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-muted); text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--border); }
  .data-table td { padding: 10px 10px; border-bottom: 1px solid var(--bg); }
  .data-table tr:last-child td { border-bottom: none; }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 500; }
  .badge-credit { background: rgba(72,187,120,0.12); color: #276749; }
  .badge-deficit { background: rgba(245,101,101,0.12); color: #9b2c2c; }
  .badge-monthly { background: rgba(61,107,158,0.12); color: #1a4a7a; }
  .row-monthly td { background: rgba(61,107,158,0.04); font-style: italic; }

  /* ── BALANCE BAR ── */
  .balance-bar-track { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; }
  .balance-bar-fill { height: 100%; border-radius: 4px; transition: width 0.5s ease; background: var(--credit); }
  .balance-bar-fill.neg { background: var(--deficit); }

  /* ── CHARTS ── */
  .chart-wrap { position: relative; height: 240px; }
  .chart-wrap-sm { position: relative; height: 200px; }
  .chart-wrap-lg { position: relative; height: 300px; }

  /* ── MONTH NAV ── */
  .month-nav { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
  .month-nav select { flex: 1; }

  /* ── PREDICTION ── */
  .predict-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .predict-cell { display: flex; flex-direction: column; gap: 5px; }
  .predict-cell label { font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .predict-cell input { padding: 10px 8px; font-size: 14px; text-align: center; }
  .predict-result { padding: 16px; border-radius: 12px; margin-top: 14px; }
  .predict-result.pos { background: rgba(72,187,120,0.1); border: 1px solid rgba(72,187,120,0.3); }
  .predict-result.neg { background: rgba(245,101,101,0.08); border: 1px solid rgba(245,101,101,0.3); }
  .predict-result-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px; }
  .predict-result-value { font-family: 'Fraunces', serif; font-size: 26px; font-weight: 600; }
  .predict-result.pos .predict-result-value { color: var(--credit); }
  .predict-result.neg .predict-result-value { color: var(--deficit); }
  .predict-meta { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 10px; }
  .predict-meta-item { display: flex; flex-direction: column; gap: 2px; }
  .predict-meta-item span:first-child { font-size: 9px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .predict-meta-item span:last-child { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; }

  /* ── WINTER GOAL SECTION ── */
  .winter-goal-banner {
    background: linear-gradient(135deg, var(--sky) 0%, var(--sky-mid) 100%);
    color: white;
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 16px;
    position: relative;
    overflow: hidden;
  }
  .winter-goal-banner::before {
    content: '❄️';
    position: absolute;
    right: 16px; top: 12px;
    font-size: 40px;
    opacity: 0.25;
  }
  .winter-goal-title { font-family: 'Fraunces', serif; font-size: 17px; font-weight: 600; margin-bottom: 6px; }
  .winter-goal-sub { font-size: 11px; opacity: 0.65; line-height: 1.5; }
  .scenario-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
  .scenario-card {
    border-radius: 12px;
    padding: 14px;
    border: 1.5px solid;
  }
  .scenario-card.high { border-color: rgba(245,101,101,0.4); background: rgba(245,101,101,0.05); }
  .scenario-card.low { border-color: rgba(72,187,120,0.4); background: rgba(72,187,120,0.05); }
  .scenario-label { font-size: 9px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); margin-bottom: 4px; }
  .scenario-value { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; }
  .scenario-card.high .scenario-value { color: var(--deficit); }
  .scenario-card.low .scenario-value { color: var(--credit); }
  .scenario-detail { font-size: 10px; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .goal-progress-wrap { margin-bottom: 8px; }
  .goal-progress-label { display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); margin-bottom: 5px; }
  .goal-progress-track { height: 10px; background: var(--border); border-radius: 5px; overflow: hidden; position: relative; }
  .goal-progress-fill { height: 100%; border-radius: 5px; transition: width 0.6s ease; position: relative; }
  .goal-progress-fill.good { background: linear-gradient(90deg, var(--credit), #38a169); }
  .goal-progress-fill.warn { background: linear-gradient(90deg, var(--sun), #d97706); }
  .goal-progress-fill.bad { background: linear-gradient(90deg, var(--deficit), #c53030); }
  .goal-threshold { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(0,0,0,0.3); }

  /* ── DOLLAR TILES ── */
  .stat-tile.saved::before { background: #38a169; }
  .stat-tile.banked::before { background: var(--sun); }
  .stat-tile.owed::before { background: var(--deficit); }
  .stat-tile.netbanked::before { background: var(--credit); }
  .stat-tile.netbanked.short::before { background: var(--deficit); }
  .stat-number.green { color: #276749; }
  .stat-number.gold { color: #b7791f; }
  .stat-sub { font-size: 10px; color: var(--text-muted); margin-top: 5px; line-height: 1.4; }
  .rate-badge {
    display: inline-flex; align-items: center; gap: 4px;
    background: var(--sun-light); color: #7a4a00;
    border-radius: 12px; padding: 2px 8px;
    font-size: 10px; cursor: pointer;
    border: 1px solid rgba(245,166,35,0.3);
    transition: background 0.15s;
    margin-top: 6px;
  }
  .rate-badge:hover { background: #fde08a; }
  .rate-edit-row { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .rate-input-inline {
    width: 90px; padding: 6px 8px;
    border: 1.5px solid var(--sun);
    border-radius: 8px; font-family: 'DM Mono', monospace;
    font-size: 15px; color: var(--text);
    background: white;
  }
  .rate-input-inline:focus { outline: none; box-shadow: 0 0 0 3px rgba(245,166,35,0.2); }
  .btn-rate-save { padding: 6px 14px; font-size: 11px; background: var(--sun); color: var(--sky); border: none; border-radius: 8px; font-family: 'DM Mono', monospace; font-weight: 600; cursor: pointer; }

  /* ── SETTINGS PANEL ── */
  .settings-row { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--border); gap: 12px; flex-wrap: wrap; }
  .settings-row:last-child { border-bottom: none; }
  .settings-label { font-size: 13px; font-weight: 500; color: var(--text); }
  .settings-desc { font-size: 11px; color: var(--text-muted); margin-top: 2px; line-height: 1.4; }

  /* ── ARCHIVE ── */
  .archive-year-header { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; color: var(--sky); margin-bottom: 10px; }
  .archive-meta { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
  .archive-year { margin-bottom: 24px; }

  /* ── EMPTY ── */
  .empty { text-align: center; padding: 40px 20px; color: var(--text-muted); }
  .empty-icon { font-size: 36px; margin-bottom: 10px; }
  .empty-text { font-size: 12px; line-height: 1.5; }

  /* ── DIVIDER ── */
  .divider { height: 1px; background: var(--border); margin: 16px 0; }

  /* ── INFO PILL ── */
  .info-pill { display: inline-flex; align-items: center; gap: 5px; background: var(--sun-light); color: #7a4a00; border-radius: 20px; padding: 4px 10px; font-size: 10px; flex-wrap: wrap; }

  /* ── SECTION HEADER ── */
  .section-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 10px; }
  .section-title { font-family: 'Fraunces', serif; font-size: 20px; font-weight: 600; color: var(--sky); }

  /* ── DESKTOP OVERRIDES ── */
  @media (min-width: 700px) {
    .top-tabs { display: block; }
    .bottom-nav { display: none; }
    .main { padding: 28px 28px 40px; }
    .header-inner { padding: 20px 28px 16px; }
    .header h1 { font-size: 22px; }
    .sun-icon { width: 44px; height: 44px; }
    .grid-4 { grid-template-columns: repeat(4, 1fr); }
    .predict-grid { grid-template-columns: repeat(6, 1fr); }
    .chart-wrap { height: 280px; }
    .chart-wrap-sm { height: 240px; }
    .chart-wrap-lg { height: 360px; }
    .header-stats { gap: 24px; }
    .hstat-value { font-size: 20px; }
    .hstat-label { font-size: 10px; }
  }
  @media (min-width: 1000px) {
    .main-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .main-grid-2 .card + .card { margin-top: 0; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="header-bg"></div>
  <div class="header-inner" style="position:relative;z-index:2">
    <div class="header-title-group">
      <div class="sun-icon"></div>
      <div>
        <h1><span>Solar</span> Net Metering</h1>
        <div class="header-sub">Maine · Credit Tracker</div>
      </div>
    </div>
    <div class="header-stats">
      <div class="hstat">
        <div class="hstat-label">Month</div>
        <div class="hstat-value neutral" id="hMonthBal">— kWh</div>
      </div>
      <div class="hstat">
        <div class="hstat-label">12-Mo</div>
        <div class="hstat-value positive" id="hYearBal">— kWh</div>
      </div>
    </div>
  </div>
  <!-- Desktop tabs -->
  <div class="top-tabs">
    <div class="top-tabs-inner">
      <button class="tab active" onclick="switchTab('log',this)">Daily Log</button>
      <button class="tab" onclick="switchTab('dashboard',this)">Dashboard</button>
      <button class="tab" onclick="switchTab('charts',this)">Charts</button>
      <button class="tab" onclick="switchTab('predict',this)">Predictive Model</button>
      <button class="tab" onclick="switchTab('archive',this)">Archive</button>
      <button class="tab" onclick="switchTab('settings',this)">Settings</button>
    </div>
  </div>
</div>

<!-- BOTTOM NAV (mobile) -->
<nav class="bottom-nav">
  <button class="bnav-item active" onclick="switchTab('log',this)" data-tab="log">
    <svg viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
    Log
  </button>
  <button class="bnav-item" onclick="switchTab('dashboard',this)" data-tab="dashboard">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
    Dash
  </button>
  <button class="bnav-item" onclick="switchTab('charts',this)" data-tab="charts">
    <svg viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
    Charts
  </button>
  <button class="bnav-item" onclick="switchTab('predict',this)" data-tab="predict">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    Predict
  </button>
  <button class="bnav-item" onclick="switchTab('archive',this)" data-tab="archive">
    <svg viewBox="0 0 24 24"><polyline points="21 8 21 21 3 21 3 8"/><rect x="1" y="3" width="22" height="5" rx="1"/><line x1="10" y1="12" x2="14" y2="12"/></svg>
    Archive
