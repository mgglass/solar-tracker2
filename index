// ── ROLLING CREDIT LEDGER (Maine: kWh credits expire after 12 months) ──
// A credit earned in month M can be used through month M + CREDIT_LIFE_MONTHS
// (e.g. June 2025 credits are usable through June 2026). Deficit months use up the
// oldest credits first (FIFO).
const CREDIT_LIFE_MONTHS = 12;
function monthIdx(ym) { const [y, m] = ym.split('-'); return parseInt(y) * 12 + parseInt(m) - 1; }
function rollingCredits(asOfYM) {
  const asOf = monthIdx(asOfYM);
  let batches = []; // [{idx, kwh}] oldest first
  const expire = i => { batches = batches.filter(b => i - b.idx <= CREDIT_LIFE_MONTHS); };
  // Fully settle every earlier month (credits added, deficits drawn from oldest credits)
  allMonths().filter(m => monthIdx(m) < asOf).sort().forEach(m => {
    const i = monthIdx(m);
    expire(i);
    const net = monthSum(m).net;
    if (net > 0) batches.push({ idx: i, kwh: net });
    else if (net < 0) {
      let need = -net;
      for (const b of batches) { const take = Math.min(b.kwh, need); b.kwh -= take; need -= take; if (need <= 0) break; }
      batches = batches.filter(b => b.kwh > 0);
    }
  });
  // The as-of month: add its credit, but hold its deficit aside (that is the "owed" amount)
  expire(asOf);
  const net = monthSum(asOfYM).net;
  if (net > 0) batches.push({ idx: asOf, kwh: net });
  const bankedKwh = batches.reduce((a, b) => a + b.kwh, 0);
  const deficitKwh = net < 0 ? -net : 0;
  // Next expiry: apply this month's deficit to the oldest credits first, then see what is left
  let need = deficitKwh;
  const left = batches.map(b => ({ idx: b.idx, kwh: b.kwh }));
  for (const b of left) { const take = Math.min(b.kwh, need); b.kwh -= take; need -= take; if (need <= 0) break; }
  const next = left.find(b => b.kwh > 0.005);
  const expiring = next ? { kwh: next.kwh, ym: Math.floor((next.idx + CREDIT_LIFE_MONTHS) / 12) + '-' + String((next.idx + CREDIT_LIFE_MONTHS) % 12 + 1).padStart(2, '0') } : null;
  return { bankedKwh, deficitKwh, balance: bankedKwh - deficitKwh, expiring };
}

// ── DOLLAR CALCULATIONS ──
function calcDollars() {
  const rate = loadRate();
  const ym = currentYM();
  const mo = monthSum(ym);
  const saved = mo.solar * rate;

  // Banked = unexpired credits (rolling 12 months) x rate
  const rc = rollingCredits(ym);
  const bankedYTD = rc.bankedKwh * rate;
  const moCredit = mo.net > 0 ? mo.net * rate : 0;

  // Owed this month = current month deficit x rate (0 if credit)
  const owed = rc.deficitKwh * rate;

  // Banked minus owed
  const netBanked = bankedYTD - owed;

  return { saved, bankedYTD, moCredit, owed, netBanked, rate };
}

function expiryText(rc) {
  if (!rc.expiring) return '';
  const [y, m] = rc.expiring.ym.split('-');
  return '⏳ ' + rc.expiring.kwh.toFixed(1) + ' kWh expire after ' + MONTHS[parseInt(m) - 1] + ' ' + y;
}

function renderDollarTiles(prefix) {
  const { saved, bankedYTD, moCredit, owed, netBanked } = calcDollars();
  const fmt$ = v => '$' + v.toFixed(2);
  document.getElementById(prefix + 'DollarSaved').textContent = fmt$(saved);
  document.getElementById(prefix + 'DollarBankedYTD').textContent = fmt$(bankedYTD);
  const moEl = document.getElementById(prefix + 'DollarBankedMo');
  moEl.textContent = moCredit > 0 ? `+ ${fmt$(moCredit)} this month` : '';
  document.getElementById(prefix + 'DollarOwed').textContent = fmt$(owed);
  const netEl = document.getElementById(prefix + 'DollarNet');
  const neg = netBanked < -0.005;
  netEl.textContent = (neg ? '-' : '') + fmt$(Math.abs(netBanked));
  netEl.className = 'stat-number ' + (neg ? 'neg' : 'green');
  document.getElementById(prefix + 'DollarNetTile').className = 'stat-tile netbanked' + (neg ? ' short' : '');
}

// Export / Clear data
function exportData() {
  const blob = new Blob([JSON.stringify(DATA, null, 2)], {type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'solar-data-' + today() + '.json';
  a.click();
}
function importData(ev) {
  const file = ev.target.files && ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const obj = JSON.parse(reader.result);
      if (!obj || typeof obj !== 'object' || Array.isArray(obj)) throw new Error('bad format');
      const bad = Object.values(obj).some(v => !v || typeof v.solar !== 'number' || typeof v.usage !== 'number');
      if (bad) throw new Error('bad entries');
      const n = Object.keys(obj).length;
      if (!confirm('Import ' + n + ' entries? Entries with the same date will be overwritten; all others are kept.')) return;
      DATA = Object.assign({}, DATA, obj);
      saveData(DATA);
      renderAll();
      if (document.getElementById('panel-dashboard').classList.contains('active')) renderDashboard();
      alert('Imported ' + n + ' entries.');
    } catch (e) {
      alert('That file could not be imported. Please choose a JSON file exported from this app.');
    }
    ev.target.value = '';
  };
  reader.readAsText(file);
}
function clearAllData() {
  if (!confirm('This will permanently delete ALL your logged data. Are you sure?')) return;
  if (!confirm('Last chance — this cannot be undone. Delete everything?')) return;
  DATA = {};
  saveData(DATA);
  renderAll();
  if (document.getElementById('panel-dashboard').classList.contains('active')) renderDashboard();
}


function loadData() { try { return JSON.parse(localStorage.getItem('solarData') || '{}'); } catch(e) { return {}; } }
function saveData(d) { localStorage.setItem('solarData', JSON.stringify(d)); }
let DATA = loadData();

// ── HELPERS ──
function today() { return new Date().toISOString().slice(0,10); }
function parseDate(s) { return new Date(s + 'T00:00:00'); }
function fmt(n) { return (n >= 0 ? '+' : '') + n.toFixed(2); }
function fmtAbs(n) { return Math.abs(n).toFixed(2); }
function getMonthEntries(ym) {
  return Object.entries(DATA).filter(([d]) => {
    if (isMonthlyKey(d)) return ymFromMonthlyKey(d) === ym;
    return d.startsWith(ym);
  }).sort(([a],[b]) => a.localeCompare(b));
}
function getYearEntries(y) {
  return Object.entries(DATA).filter(([d]) => {
    if (isMonthlyKey(d)) return ymFromMonthlyKey(d).startsWith(y);
    return d.startsWith(y);
  }).sort(([a],[b]) => a.localeCompare(b));
}
function allYears() {
  return [...new Set(Object.keys(DATA).map(d => {
    if (isMonthlyKey(d)) return ymFromMonthlyKey(d).slice(0,4);
    return d.slice(0,4);
  }))].sort();
}
function allMonths() {
  return [...new Set(Object.keys(DATA).map(d => {
    if (isMonthlyKey(d)) return ymFromMonthlyKey(d);
    return d.slice(0,7);
  }))].sort();
}
function monthSum(ym) { let s=0,u=0; getMonthEntries(ym).forEach(([,v])=>{s+=v.solar;u+=v.usage;}); return {solar:s,usage:u,net:s-u}; }
function yearSum(y) { let s=0,u=0; getYearEntries(y).forEach(([,v])=>{s+=v.solar;u+=v.usage;}); return {solar:s,usage:u,net:s-u}; }
function currentYM() { const n=new Date(); return n.getFullYear()+'-'+String(n.getMonth()+1).padStart(2,'0'); }
function currentYear() { return String(new Date().getFullYear()); }

// ── TAB SWITCHING ──
function switchTab(tab, el) {
  document.querySelectorAll('.tab, .bnav-item').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll(`[data-tab="${tab}"]`).forEach(t => t.classList.add('active'));
  if (el) el.classList.add('active');
  document.getElementById('panel-' + tab).classList.add('active');
  if (tab === 'dashboard') renderDashboard();
  if (tab === 'charts') renderCharts();
  if (tab === 'archive') renderArchive();
  if (tab === 'predict') initPredict();
  if (tab === 'settings') updateRateDisplays();
  window.scrollTo({top:0, behavior:'smooth'});
}

// ── MONTHLY BULK ENTRY ──
const MONTHLY_KEY_PREFIX = 'monthly::';
function monthlyKey(ym) { return MONTHLY_KEY_PREFIX + ym; }
function isMonthlyKey(k) { return k.startsWith(MONTHLY_KEY_PREFIX); }
function ymFromMonthlyKey(k) { return k.replace(MONTHLY_KEY_PREFIX, ''); }

function populateBulkSelectors() {
  const mSel = document.getElementById('bulkMonth');
  const ySel = document.getElementById('bulkYear');
  mSel.innerHTML = MONTHS_FULL.map((m,i) => `<option value="${i}">${m}</option>`).join('');
  const now = new Date();
  const curYear = now.getFullYear();
  let yHtml = '';
  for (let y = curYear; y >= curYear - 10; y--) yHtml += `<option value="${y}">${y}</option>`;
  ySel.innerHTML = yHtml;
  // Default to last month
  let m = now.getMonth() - 1, y = curYear;
  if (m < 0) { m = 11; y--; }
  mSel.value = m;
  ySel.value = y;
}

function addMonthlyEntry() {
  const mo = parseInt(document.getElementById('bulkMonth').value);
  const yr = parseInt(document.getElementById('bulkYear').value);
  const solar = parseFloat(document.getElementById('bulkSolar').value);
  const usage = parseFloat(document.getElementById('bulkUsage').value);
  if (isNaN(solar) || solar < 0) return alert('Please enter a valid solar total.');
  if (isNaN(usage) || usage < 0) return alert('Please enter a valid usage total.');
  const ym = yr + '-' + String(mo + 1).padStart(2, '0');
  // Check if daily entries already exist for this month
  const existing = getMonthEntries(ym).filter(([k]) => !isMonthlyKey(k));
  if (existing.length > 0) {
    if (!confirm(`There are already ${existing.length} daily entries for ${MONTHS_FULL[mo]} ${yr}. Adding a monthly total will coexist with them — totals will include both. Continue?`)) return;
  }
  DATA[monthlyKey(ym)] = { solar, usage, monthly: true };
  saveData(DATA);
  document.getElementById('bulkSolar').value = '';
  document.getElementById('bulkUsage').value = '';
  // Switch log view to that month
  populateMonthFilter();
  document.getElementById('logMonthFilter').value = ym;
  renderLogTable();
  renderHeader();
}

function deleteMonthlyEntry(ym) {
  if (!confirm('Delete monthly total for ' + ym + '?')) return;
  delete DATA[monthlyKey(ym)];
  saveData(DATA);
  renderAll();
}


function addEntry() {
  const date = document.getElementById('entryDate').value;
  const solar = parseFloat(document.getElementById('entrySolar').value);
  const usage = parseFloat(document.getElementById('entryUsage').value);
  if (!date) return alert('Please select a date.');
  if (isNaN(solar) || solar < 0) return alert('Please enter a valid solar value.');
  if (isNaN(usage) || usage < 0) return alert('Please enter a valid usage value.');
  DATA[date] = { solar, usage };
  saveData(DATA);
  document.getElementById('entrySolar').value = '';
  document.getElementById('entryUsage').value = '';
  renderAll();
}
function deleteEntry(date) {
  if (!confirm('Delete entry for ' + date + '?')) return;
  delete DATA[date]; saveData(DATA); renderAll();
}

// ── HEADER ──
function renderHeader() {
  const mo = monthSum(currentYM());
  const yr = { net: rollingCredits(currentYM()).balance };
  const hMo = document.getElementById('hMonthBal');
  hMo.textContent = fmt(mo.net) + ' kWh';
  hMo.className = 'hstat-value ' + (mo.net >= 0 ? 'positive' : 'negative');
  const hYr = document.getElementById('hYearBal');
  hYr.textContent = fmt(yr.net) + ' kWh';
  hYr.className = 'hstat-value ' + (yr.net >= 0 ? 'positive' : 'negative');
}

// ── LOG TABLE ──
function populateMonthFilter() {
  const sel = document.getElementById('logMonthFilter');
  const cur = sel.value;
  const ym = currentYM();
  const options = [...new Set([ym, ...allMonths()])].sort().reverse();
  sel.innerHTML = options.map(m => {
    const [y,mo] = m.split('-');
    return `<option value="${m}" ${m===(cur||ym)?'selected':''}>${MONTHS_FULL[parseInt(mo)-1]} ${y}</option>`;
  }).join('');
  if (!cur) sel.value = ym;
}
function renderLogTable() {
  const ym = document.getElementById('logMonthFilter').value || currentYM();
  const entries = getMonthEntries(ym);
  const mo = monthSum(ym);
  document.getElementById('tileMoSolar').textContent = mo.solar.toFixed(2);
  document.getElementById('tileMoUsage').textContent = mo.usage.toFixed(2);
  document.getElementById('tileMoBal').textContent = fmtAbs(mo.net);
  document.getElementById('tileMoBalLabel').textContent = mo.net >= 0 ? 'kWh net credit' : 'kWh net deficit';
  document.getElementById('tileMoBal').className = 'stat-number ' + (mo.net >= 0 ? 'pos' : 'neg');
  document.getElementById('tileMoBalTile').className = 'stat-tile ' + (mo.net >= 0 ? 'credit' : 'deficit');
  const rc_ = rollingCredits(ym);
  document.getElementById('tileYrBal').textContent = fmtAbs(rc_.balance);
  document.getElementById('tileYrBalLabel').textContent = rc_.balance >= 0 ? 'kWh unexpired credit' : 'kWh net deficit';
  document.getElementById('tileYrBal').className = 'stat-number ' + (rc_.balance >= 0 ? 'pos' : 'neg');
  document.getElementById('tileYrBalTile').className = 'stat-tile ' + (rc_.balance >= 0 ? 'credit' : 'deficit');
  document.getElementById('tileExpiry').textContent = expiryText(rc_);
  document.getElementById('logEntriesCount').textContent = entries.length + ' entries';
  const wrap = document.getElementById('logTableWrap');
  if (entries.length === 0) {
    wrap.innerHTML = '<div class="empty"><div class="empty-icon">📋</div><div class="empty-text">No entries for this month.</div></div>';
    return;
  }
  // Separate monthly vs daily entries
  const monthlyEntries = entries.filter(([k]) => isMonthlyKey(k));
  const dailyEntries = entries.filter(([k]) => !isMonthlyKey(k));

  let run = 0;
  const buildRow = (key, v, isMonthly) => {
    const net = v.solar - v.usage; run += net;
    if (isMonthly) {
      const [y, mo] = ymFromMonthlyKey(key).split('-');
      const label = MONTHS_FULL[parseInt(mo)-1] + ' ' + y + ' (monthly total)';
      return `<tr class="row-monthly">
        <td style="white-space:nowrap">${label} <span class="badge badge-monthly">monthly</span></td>
        <td style="color:var(--sun)">${v.solar.toFixed(2)}</td>
        <td style="color:var(--sky-light)">${v.usage.toFixed(2)}</td>
        <td><span class="badge ${net>=0?'badge-credit':'badge-deficit'}">${fmt(net)}</span></td>
        <td style="color:var(--text-muted)">—</td>
        <td><button class="btn btn-danger" onclick="deleteMonthlyEntry('${ymFromMonthlyKey(key)}')">✕</button></td>
      </tr>`;
    } else {
      const label = parseDate(key).toLocaleDateString('en-US', {weekday:'short',month:'short',day:'numeric'});
      return `<tr>
        <td style="white-space:nowrap">${label}</td>
        <td style="color:var(--sun)">${v.solar.toFixed(2)}</td>
        <td style="color:var(--sky-light)">${v.usage.toFixed(2)}</td>
        <td><span class="badge ${net>=0?'badge-credit':'badge-deficit'}">${fmt(net)}</span></td>
        <td style="color:var(--text-muted)">${fmt(run)}</td>
        <td><button class="btn btn-danger" onclick="deleteEntry('${key}')">✕</button></td>
      </tr>`;
    }
  };

  const monthlyRows = monthlyEntries.map(([k,v]) => buildRow(k, v, true)).join('');
  const dailyRows = dailyEntries.map(([k,v]) => buildRow(k, v, false)).join('');
  const dividerRow = (monthlyRows && dailyRows) ? `<tr><td colspan="6" style="padding:4px 10px;background:var(--bg);font-size:10px;color:var(--text-muted);letter-spacing:0.06em;text-transform:uppercase">Daily entries</td></tr>` : '';
  wrap.innerHTML = `<div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>☀️ Gen</th><th>⚡ Use</th><th>Balance</th><th>Running</th><th></th></tr></thead><tbody>${monthlyRows}${dividerRow}${dailyRows}</tbody></table></div>`;
}

